        "evalues1": [[ {"@id": "var:ivalues1"}   ]],
        "aprops":   [[ {"@id": "var:aprops"},   {"@id": "prov:type"}        ]],
        "avalues":  [[ {"@id": "var:avalues"},  {"@id": "resp:HandingOver"} ]],
        "dprops":   [[ {"@id": "var:dprops"},   {"@id": "prov:type"}        ]],
        "dvalues":  [[ {"@id": "var:dvalues"},  {"@id": "resp:HandingOver"} ]],
        "uprops":   [[ {"@id": "var:uprops1"},  {"@id": "prov:role"}        ]],
        "uvalues":  [[ {"@id": "var:uvalues1"}, {"@id": "provext:asItem"}       ]],
