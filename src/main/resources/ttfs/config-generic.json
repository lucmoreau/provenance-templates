{
    "template_path": ["src/main/resources/templates", "target/generated-templates"],
    "bindings_path": ["src/main/resources/bindings/org/openprovenance/bindings/generic"],
    "output_dir": "generated-templates",

    "variableMaps": ["./common-ns.json"],

    "tasks": [
        {
            "type": "instantiate",
            "template": "org.openprovenance.templates.triangles.Triangle1-UGD",
            "output": "org/openprovenance/templates/generic/new-transforming1",
            "bindings": "new-transforming1.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/generic/prov/prov-new-transforming1.prov-csv"
        },
        {
            "type": "instantiate",
            "template": "org.openprovenance.templates.generic.Transforming1",
            "output": "org/openprovenance/templates/generic/forking2",
            "bindings": "forking2.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "copyinput": true,
            "hasProvenance": "org/openprovenance/templates/generic/prov/prov-forking2.prov-csv"
        },
        {
            "type": "instantiate",
            "template": "org.openprovenance.templates.generic.Transforming1",
            "output": "org/openprovenance/templates/generic/joining2",
            "bindings": "joining2.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/generic/prov/prov-joining2.prov-csv"
        },
        {
            "type": "instantiate",
            "template": "org.openprovenance.templates.generic.Transforming1",
            "output": "org/openprovenance/templates/generic/parallel2",
            "bindings": "parallel2.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/generic/prov/prov-parallel2.prov-csv"
        },
        {
            "type": "instantiate",
            "template": "org.openprovenance.templates.generic.Transforming1",
            "output": "org/openprovenance/templates/generic/product2-2",
            "bindings": "product2-2.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/generic/prov/prov-product2-2.prov-csv"

        },
        {
            "type": "instantiate",
            "template": "org/openprovenance/templates/generic/joining2",
            "template_path": ["target/generated-templates"],
            "output": "org/openprovenance/templates/generic/binaryop",
            "bindings": "binaryop.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/generic/prov/prov-binaryop.prov-csv"
        }
    ]


}


