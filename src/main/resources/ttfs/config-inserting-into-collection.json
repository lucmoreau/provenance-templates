{
    "template_path": [
        "src/main/resources/templates/org/openprovenance/templates/primitive",
        "target/generated-templates/org/openprovenance/templates/triangles/triangle1-ugd",
        "target/generated-templates/org/openprovenance/templates/triangles/triangle6-ugm", "."],
    "bindings_path": ["src/main/resources/bindings/org/openprovenance/bindings/collections/inserting"],
    "output_dir": "generated-templates/org/openprovenance/templates/collections/inserting",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an triangle1-ugd pattern",
            "template": "triangle1-ugd.provn",
            "output": "collection-insert-triangle1-ugd",
            "bindings": "collection-insert-triangle1-ugd.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-collection-insert-triangle1-ugd.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle1-ugd pattern",
            "template": "triangle1-ugd.provn",
            "output": "collection-insert-triangle2-ugd",
            "bindings": "collection-insert-triangle2-ugd.json",
            "formats": ["jsonld" ,"provn", "png", "svg"],
            "hasProvenance": "prov-collection-insert-triangle2-ugd.prov-csv"
        },


        {
            "type": "instantiate",
            "description": "Instantiating an triangle1-ugd pattern",
            "template": "triangle1-ugd.provn",
            "output": "collection-insert-triangle3-ugd",
            "bindings": "collection-insert-triangle3-ugd.json",
            "formats": ["jsonld" ,"provn", "png", "svg"],
            "hasProvenance": "prov-collection-insert-triangle3-ugd.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating a membership pattern",
            "template": "qualified-membership0.jsonld",
            "output": "membership",
            "bindings": "membership.json",
            "formats": ["jsonld", "provn","png", "svg"],
            "hasProvenance": "prov-membership.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": [
                "collection-insert-triangle1-ugd.jsonld",
                "collection-insert-triangle2-ugd.jsonld",
                "collection-insert-triangle3-ugd.jsonld",
                "membership.jsonld"
            ],
            "output": "collection-inserting",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-collection-inserting.prov-csv"
        }


    ]
}
