        },
        {
            "type": "instantiate",
            "template": "org/openprovenance/templates/simple/joining2",
            "output": "org/openprovenance/templates/simple/binaryop",
            "bindings": "simple-binaryop.json",
            "formats": ["jsonld", "provn", "png", "svg", "qualified.png"],
            "hasProvenance": "org/openprovenance/templates/simple/prov/prov-binaryop.prov-csv",
            "variableCheck": "src/main/resources/variable-check/simple/variables.json"

        }
    ]


}


