{
    "template_path": [
        "src/main/resources/templates/org/openprovenance/templates/primitive",
        "target/generated-templates/triangle1-ugd",
        "target/generated-templates/triangle2-sds",
        "target/generated-templates/triangle3-aga",
        "target/generated-templates/triangle6-ugm", "."],
    "bindings_path": ["src/main/resources/bindings/org/openprovenance/bindings/physical/transporting"],
    "output_dir": "generated-templates/org/openprovenance/templates/physical/transporting",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an triangle1-ugd pattern",
            "template": "triangle1-ugd.provn",
            "output": "transporting-ugd",
            "bindings": "transporting-ugd.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-transporting-ugd.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (a) pattern",
            "template": "triangle3-aga.provn",
            "output": "transporting-aga-agent",
            "bindings": "transporting-aga-agent.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-transporting-aga-agent.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle2-sds pattern",
            "template": "triangle2-sds.provn",
            "output": "transporting-sds",
            "bindings": "transporting-sds.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-transporting-sds.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging all temporary transporting outputs",
            "addOutputDirToInputPath": true,
            "inputs": [
                "transporting-ugd.jsonld",
                "transporting-aga-agent.jsonld",
                "transporting-sds.jsonld"
            ],
            "output": "transporting",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-transporting.prov-csv"
        }
    ]
}
