{
    "template_path": ["templates"],
    "bindings_path": ["bindings/org/openprovenance/bindings/algebra/triangle4-aia"],
    "output_dir": "generated-templates",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an entity pattern",
            "template": "org.openprovenance.templates.primitive.Entity0",
            "output": "org/openprovenance/templates/triangles/triangle4-aia/entity",
            "bindings": "entity.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle4-aia/prov/prov-entity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an agent pattern",
            "template": "org.openprovenance.templates.primitive.Agent0",
            "output": "org/openprovenance/templates/triangles/triangle4-aia/agent",
            "bindings": "agent.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle4-aia/prov/prov-agent.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an activity pattern",
            "template": "org.openprovenance.templates.primitive.Activity0",
            "output": "org/openprovenance/templates/triangles/triangle4-aia/activity",
            "bindings": "activity.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle4-aia/prov/prov-activity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a derivation pattern",
            "template": "org.openprovenance.templates.primitive.Attribution0",
            "output": "org/openprovenance/templates/triangles/triangle4-aia/attribution",
            "bindings": "attribution.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle4-aia/prov/prov-attribution.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an association pattern",
            "template": "org.openprovenance.templates.primitive.Association0",
            "output": "org/openprovenance/templates/triangles/triangle4-aia/association",
            "bindings": "association.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle4-aia/prov/prov-association.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a invalidation pattern",
            "template": "org.openprovenance.templates.primitive.Invalidation0",
            "output": "org/openprovenance/templates/triangles/triangle4-aia/invalidation",
            "bindings": "invalidation.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle4-aia/prov/prov-invalidation.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": [
                "org/openprovenance/templates/triangles/triangle4-aia/entity",
                "org/openprovenance/templates/triangles/triangle4-aia/activity",
                "org/openprovenance/templates/triangles/triangle4-aia/agent",
                "org/openprovenance/templates/triangles/triangle4-aia/association",
                "org/openprovenance/templates/triangles/triangle4-aia/attribution",
                "org/openprovenance/templates/triangles/triangle4-aia/invalidation"],
            "output": "org/openprovenance/templates/triangles/triangle4-aia/triangle4-aia",
            "formats": ["provn", "png", "svg", "qualified.png"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle4-aia/prov/prov-triangle4-aia.prov-csv",
            "variableCheck": "variable-check/triangles/variables.json"
        }


    ]
}
