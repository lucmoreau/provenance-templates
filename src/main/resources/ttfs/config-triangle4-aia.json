{
    "template_path": ["templates/org/openprovenance/templates/primitive", "."],
    "bindings_path": ["bindings/org/openprovenance/bindings/algebra/triangle4-aia"],
    "output_dir": "generated-templates/triangle4-aia",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an entity pattern",
            "template": "entity0.provn",
            "output": "entity",
            "bindings": "entity.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-entity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an agent pattern",
            "template": "agent0.provn",
            "output": "agent",
            "bindings": "agent.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-agent.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an activity pattern",
            "template": "activity0.provn",
            "output": "activity",
            "bindings": "activity.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-activity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a derivation pattern",
            "template": "attribution0.provn",
            "output": "attribution",
            "bindings": "attribution.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-attribution.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an association pattern",
            "template": "association0.provn",
            "output": "association",
            "bindings": "association.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-association.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a invalidation pattern",
            "template": "invalidation0.provn",
            "output": "invalidation",
            "bindings": "invalidation.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-invalidation.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": ["entity.provn", "activity.provn", "agent.provn", "association.provn", "attribution.provn","invalidation.provn"],
            "output": "triangle4-aia",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-triangle4-aia.prov-csv"
        }


    ]
}
