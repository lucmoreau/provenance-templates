{
    "template_path": [
        "src/main/resources/templates/primitive",
        "target/generated-templates/triangle1-ugd",
        "target/generated-templates/triangle2-sds",
        "target/generated-templates/triangle3-aga",
        "target/generated-templates/triangle6-ugm", "."],
    "bindings_path": ["src/main/resources/bindings/physical/transport"],
    "output_dir": "generated-templates/physical/transport",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an triangle1-ugd pattern",
            "template": "triangle1-ugd.provn",
            "output": "transport-ugd",
            "bindings": "transport-ugd.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-transport-ugd.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (a) pattern",
            "template": "triangle3-aga.provn",
            "output": "transport-aga-agent",
            "bindings": "transport-aga-agent.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-transport-aga-agent.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle2-sds pattern",
            "template": "triangle2-sds.provn",
            "output": "transport-sds",
            "bindings": "transport-sds.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-transport-sds.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging all temporary transport outputs",
            "addOutputDirToInputPath": true,
            "inputs": [
                "transport-ugd.jsonld",
                "transport-aga-agent.jsonld",
                "transport-sds.jsonld"
            ],
            "output": "transport",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-transport.prov-csv"
        }
    ]
}
