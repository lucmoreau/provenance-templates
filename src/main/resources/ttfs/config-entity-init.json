{
    "template_path": ["templates/primitive", "."],
    "bindings_path": ["bindings/algebra/entity-init"],
    "output_dir": "generated-templates/general/entity-init",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an entity pattern",
            "template": "entity0.provn",
            "output": "entity",
            "bindings": "entity-e0-e.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "prov-entity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an entity pattern",
            "template": "entity0.provn",
            "output": "entity-location",
            "bindings": "entity-e0-e-location.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "prov-entity-location.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a specialization pattern",
            "template": "qualified-specialization0.jsonld",
            "bindings": "specialization.json",
            "output": "specialization",
            "formats": ["jsonld", "provn","png", "svg"],
            "hasProvenance": "prov-specialization.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an activity pattern",
            "template": "activity0.provn",
            "output": "activity",
            "bindings": "activity.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "prov-activity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a generation pattern for two entities",
            "template": "generation0.provn",
            "output": "generation",
            "bindings": "generation.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "prov-generation.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": [
                "entity.jsonld",
                "specialization.jsonld",
                "activity.jsonld",
                "generation.jsonld"
            ],
            "output": "entity-init",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "prov-entity-init.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": [
                "entity-location.jsonld",
                "specialization.jsonld",
                "activity.jsonld",
                "generation.jsonld"
            ],
            "output": "entity-location-init",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "prov-entity-location-init.prov-csv"
        }

    ]
}
