{
    "template_path": ["templates", "."],
    "bindings_path": ["bindings/org/openprovenance/bindings/algebra/entity-init"],
    "output_dir": "generated-templates",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an entity pattern",
            "template": "org.openprovenance.templates.primitive.Entity0",
            "output": "org/openprovenance/templates/general/entity-init/entity",
            "bindings": "entity-e0-e.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/general/entity-init/prov/prov-entity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an entity pattern",
            "template": "org.openprovenance.templates.primitive.Entity0",
            "output": "org/openprovenance/templates/general/entity-init/entity-location",
            "bindings": "entity-e0-e-location.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/general/entity-init/prov/prov-entity-location.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a specialization pattern",
            "template": "org.openprovenance.templates.primitive.Qualified-Specialization0",
            "bindings": "specialization.json",
            "output": "org/openprovenance/templates/general/entity-init/specialization",
            "formats": ["jsonld", "provn","png", "svg"],
            "hasProvenance": "org/openprovenance/templates/general/entity-init/prov/prov-specialization.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an activity pattern",
            "template": "org.openprovenance.templates.primitive.Activity0",
            "output": "org/openprovenance/templates/general/entity-init/activity",
            "bindings": "activity.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/general/entity-init/prov/prov-activity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a generation pattern for two entities",
            "template": "org.openprovenance.templates.primitive.Generation0",
            "output": "org/openprovenance/templates/general/entity-init/generation",
            "bindings": "generation.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/general/entity-init/prov/prov-generation.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": [
                "org/openprovenance/templates/general/entity-init/entity",
                "org/openprovenance/templates/general/entity-init/specialization",
                "org/openprovenance/templates/general/entity-init/activity",
                "org/openprovenance/templates/general/entity-init/generation"
            ],
            "output": "org/openprovenance/templates/general/entity-init/entity-init",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/general/entity-init/prov/prov-entity-init.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": [
                "org/openprovenance/templates/general/entity-init/entity-location",
                "org/openprovenance/templates/general/entity-init/specialization",
                "org/openprovenance/templates/general/entity-init/activity",
                "org/openprovenance/templates/general/entity-init/generation"
            ],
            "output": "org/openprovenance/templates/general/entity-init/entity-location-init",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/general/entity-init/prov/prov-entity-location-init.prov-csv"
        }

    ]
}
