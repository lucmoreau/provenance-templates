{
    "template_path": [
        "src/main/resources/templates/org/openprovenance/templates/primitive",
        "target/generated-templates/org/openprovenance/templates/triangles/triangle1-ugd",
        "target/generated-templates/org/openprovenance/templates/triangles/triangle2-sds",
        "target/generated-templates/org/openprovenance/templates/triangles/triangle3-aga",
        "target/generated-templates/org/openprovenance/templates/triangles/triangle4-aia",
        "target/generated-templates/org/openprovenance/templates/triangles/triangle6-ugm",
        "."],
    "bindings_path": ["src/main/resources/bindings/org/openprovenance/bindings/responsibility/handingover"],
    "output_dir": "generated-templates/org/openprovenance/templates/responsibility/handingover",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an triangle1-ugd pattern",
            "template": "triangle1-ugd.provn",
            "output": "handingover-ugd",
            "bindings": "handingover-ugd.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-handingover-ugd.prov-csv"
        },


        {
            "type": "instantiate",
            "description": "Instantiating an triangle2-sds pattern",
            "template": "triangle2-sds.provn",
            "output": "handingover-sds",
            "bindings": "handingover-sds.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-handingover-sds.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (a) pattern",
            "template": "triangle3-aga.provn",
            "output": "handingover-aga-ag1",
            "bindings": "handingover-aga-ag1.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-handingover-aga-ag1.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle4-agi (a) pattern",
            "template": "triangle4-aia.provn",
            "output": "handingover-aia-ag0",
            "bindings": "handingover-aia-ag0.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-handingover-aia-ag0.prov-csv"
        },


        {
            "type": "merge",
            "description": "Merging all temporary handingover outputs",
            "addOutputDirToInputPath": true,
            "inputs": [
                "handingover-ugd.jsonld",
                "handingover-sds.jsonld",
                "handingover-aga-ag1.jsonld",
                "handingover-aia-ag0.jsonld"
            ],
            "output": "handingover",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-handingover.prov-csv"
        }
    ]
}
