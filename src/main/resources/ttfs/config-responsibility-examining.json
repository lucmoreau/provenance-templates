{
    "template_path": [
        "src/main/resources/templates/primitive",
        "target/generated-templates/triangle1-ugd",
        "target/generated-templates/triangle2-sds",
        "target/generated-templates/triangle3-aga",
        "target/generated-templates/triangle4-aia",
        "target/generated-templates/triangle6-ugm", "."],
    "bindings_path": ["src/main/resources/bindings/responsibility/examining"],
    "output_dir": "generated-templates/responsibility/examining",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an triangle1-ugd pattern",
            "template": "triangle1-ugd.provn",
            "output": "examining-ugd",
            "bindings": "examining-ugd.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examining-ugd.prov-csv"
        },


        {
            "type": "instantiate",
            "description": "Instantiating an triangle2-sds pattern",
            "template": "triangle2-sds.provn",
            "output": "examining-sds",
            "bindings": "examining-sds.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examining-sds.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (a) pattern",
            "template": "triangle3-aga.provn",
            "output": "examining-aga-agent",
            "bindings": "examining-aga-agent.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examining-aga-agent.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (b) pattern",
            "template": "triangle3-aga.provn",
            "output": "examining-aga-instrument",
            "bindings": "examining-aga-instrument.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examining-aga-instrument.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an delegation0 pattern",
            "template": "delegation0.jsonld",
            "output": "examining-delegation",
            "bindings": "examining-delegation.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examining-delegation.prov-csv"
        },


        {
            "type": "merge",
            "description": "Merging all temporary examining outputs",
            "addOutputDirToInputPath": true,
            "inputs": [
                "examining-ugd.jsonld",
                "examining-sds.jsonld",
                "examining-aga-agent.jsonld",
                "examining-aga-instrument.jsonld",
                "examining-delegation.jsonld"
            ],
            "output": "examining",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examining.prov-csv"
        }
    ]
}
