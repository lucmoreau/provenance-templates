{
    "template_path": [
        "src/main/resources/templates/ptm/create-template",
        "target/generated-templates/triangle1-ugd",
        "target/generated-templates/triangle3-aga",
        "."],
    "bindings_path": ["src/main/resources/bindings/ptm/create-template"],
    "output_dir": "generated-templates/create-template",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an triangle1-ugd pattern",
            "template": "triangle1-ugd.provn",
            "output": "create-template-triangle1-ugd",
            "bindings": "create-template-triangle1-ugd.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "create-template-triangle1-ugd.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (a) pattern",
            "template": "triangle3-aga.provn",
            "output": "create-template-triangle3a-aga",
            "bindings": "create-template-triangle3a-aga.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "create-template-triangle3a-aga.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (b) pattern",
            "template": "triangle3-aga.provn",
            "output": "create-template-triangle3b-aga",
            "bindings": "create-template-triangle3b-aga.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "create-template-triangle3b-aga.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (c) pattern",
            "template": "triangle3-aga.provn",
            "output": "create-template-triangle3c-aga",
            "bindings": "create-template-triangle3c-aga.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "create-template-triangle3c-aga.prov-csv"
        },
        {
            "type": "merge",
            "description": "Merging all create-template triangle outputs",
            "addOutputDirToInputPath": true,
            "inputs": [
                "create-template-triangle1-ugd.jsonld",
                "create-template-triangle3a-aga.jsonld",
                "create-template-triangle3b-aga.jsonld",
                "create-template-triangle3c-aga.jsonld"
            ],
            "output": "create-template",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "ptm-create-template.prov-csv"
        }




    ]
}
