{
    "template_path": ["templates/org/openprovenance/templates/primitive", "."],
    "bindings_path": ["bindings/org/openprovenance/bindings/algebra/triangle1-ugd"],
    "output_dir": "generated-templates/org/openprovenance/templates/triangles/triangle1-ugd",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an entity pattern",
            "template": "entity0.provn",
            "output": "entities",
            "bindings": "entity-e0-e1.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-entities.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an activity pattern",
            "template": "activity0.provn",
            "output": "activity",
            "bindings": "activity.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-activity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a derivation pattern",
            "template": "derivation0.provn",
            "output": "derivation",
            "bindings": "derivation.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-derivation.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a usage pattern",
            "template": "usage0.provn",
            "output": "usage",
            "bindings": "usage.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-usage.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a generation pattern",
            "template": "generation0.provn",
            "output": "generation",
            "bindings": "generation.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-generation.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": ["entities.provn", "activity.provn", "derivation.provn","usage.provn","generation.provn"],
            "output": "triangle1-ugd",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-triangle1-ugd.prov-csv"
        }

    ]
}
