{
    "template_path": ["templates", "."],
    "bindings_path": ["bindings/org/openprovenance/bindings/algebra/triangle1-ugd"],
    "output_dir": "generated-templates",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an entity pattern",
            "template": "org.openprovenance.templates.primitive.Entity0",
            "output": "org/openprovenance/templates/triangles/triangle1-ugd/entities",
            "bindings": "entity-e0-e1.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle1-ugd/prov/prov-entities.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an activity pattern",
            "template": "org.openprovenance.templates.primitive.Activity0",
            "output": "org/openprovenance/templates/triangles/triangle1-ugd/activity",
            "bindings": "activity.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle1-ugd/prov/prov-activity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a derivation pattern",
            "template": "org.openprovenance.templates.primitive.Derivation0",
            "output": "org/openprovenance/templates/triangles/triangle1-ugd/derivation",
            "bindings": "derivation.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle1-ugd/prov/prov-derivation.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a usage pattern",
            "template": "org.openprovenance.templates.primitive.Usage0",
            "output": "org/openprovenance/templates/triangles/triangle1-ugd/usage",
            "bindings": "usage.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle1-ugd/prov/prov-usage.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a generation pattern",
            "template": "org.openprovenance.templates.primitive.Generation0",
            "output": "org/openprovenance/templates/triangles/triangle1-ugd/generation",
            "bindings": "generation.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle1-ugd/prov/prov-generation.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": [
                "org/openprovenance/templates/triangles/triangle1-ugd/entities",
                "org/openprovenance/templates/triangles/triangle1-ugd/activity",
                "org/openprovenance/templates/triangles/triangle1-ugd/derivation",
                "org/openprovenance/templates/triangles/triangle1-ugd/usage",
                "org/openprovenance/templates/triangles/triangle1-ugd/generation"],
            "output": "org/openprovenance/templates/triangles/triangle1-ugd/triangle1-ugd",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle1-ugd/prov/prov-triangle1-ugd.prov-csv"
        }

    ]
}
