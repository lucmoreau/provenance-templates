{
    "template_path": [
        "src/main/resources/templates/primitive",
        "target/generated-templates/triangle1-ugd",
        "target/generated-templates/triangle2-sds",
        "target/generated-templates/triangle3-aga",
        "target/generated-templates/triangle4-aia",
        "target/generated-templates/triangle6-ugm", "."],
    "bindings_path": ["src/main/resources/bindings/responsibility/examine"],
    "output_dir": "generated-templates/responsibility/examine",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an triangle1-ugd pattern",
            "template": "triangle1-ugd.provn",
            "output": "examine-ugd",
            "bindings": "examine-ugd.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examine-ugd.prov-csv"
        },


        {
            "type": "instantiate",
            "description": "Instantiating an triangle2-sds pattern",
            "template": "triangle2-sds.provn",
            "output": "examine-sds",
            "bindings": "examine-sds.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examine-sds.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (a) pattern",
            "template": "triangle3-aga.provn",
            "output": "examine-aga-agent",
            "bindings": "examine-aga-agent.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examine-aga-agent.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (b) pattern",
            "template": "triangle3-aga.provn",
            "output": "examine-aga-instrument",
            "bindings": "examine-aga-instrument.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examine-aga-instrument.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an delegation0 pattern",
            "template": "delegation0.jsonld",
            "output": "examine-delegation",
            "bindings": "examine-delegation.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examine-delegation.prov-csv"
        },


        {
            "type": "merge",
            "description": "Merging all temporary examine outputs",
            "addOutputDirToInputPath": true,
            "inputs": [
                "examine-ugd.jsonld",
                "examine-sds.jsonld",
                "examine-aga-agent.jsonld",
                "examine-aga-instrument.jsonld",
                "examine-delegation.jsonld"
            ],
            "output": "examine",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "prov-examine.prov-csv"
        }
    ]
}
