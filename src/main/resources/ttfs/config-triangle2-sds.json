{
    "template_path": ["templates/primitive", "."],
    "bindings_path": ["bindings/algebra/triangle2-sds"],
    "output_dir": "generated-templates/triangle2-sds",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an entity pattern",
            "template": "entity0.provn",
            "output": "entity",
            "bindings": "entity-e0-e1-e2.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-entity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a derivation pattern",
            "template": "derivation0.provn",
            "output": "derivation",
            "bindings": "derivation.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-derivation.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a specialization pattern",
            "template": "qualified-specialization0.jsonld",
            "bindings": "specialization1.json",
            "output": "specialization1",
            "formats": ["jsonld", "provn","png", "svg"],
            "hasProvenance": "prov-specialization1.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a specialization pattern",
            "template": "qualified-specialization0.jsonld",
            "bindings": "specialization2.json",
            "output": "specialization2",
            "formats": ["jsonld", "provn","png", "svg"],
            "hasProvenance": "prov-specialization2.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": ["entity.provn", "derivation.provn", "specialization1.jsonld", "specialization2.jsonld"],
            "output": "triangle2-sds",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "prov-triangle2-sds.prov-csv"
        }

    ]
}
