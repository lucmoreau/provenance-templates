{
    "template_path": ["templates/primitive", "."],
    "bindings_path": ["bindings/algebra"],
    "output_dir": "generated-templates",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiation",
            "description": "Instantiating an entity pattern",
            "input": "entity0.provn",
            "output": "entities",
            "bindings": "entity-e0-e1.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-entities.prov-csv"
        },
        {
            "type": "instantiation",
            "description": "Instantiating an activity pattern",
            "input": "activity0.provn",
            "output": "activity",
            "bindings": "activity.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-activity.prov-csv"
        },
        {
            "type": "instantiation",
            "description": "Instantiating a derivation pattern",
            "input": "derivation0.provn",
            "output": "derivation",
            "bindings": "derivation.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-derivation.prov-csv"
        },
        {
            "type": "instantiation",
            "description": "Instantiating a usage pattern",
            "input": "usage0.provn",
            "output": "usage",
            "bindings": "usage.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-usage.prov-csv"
        },
        {
            "type": "instantiation",
            "description": "Instantiating a generation pattern",
            "input": "generation0.provn",
            "output": "generation",
            "bindings": "generation.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-generation.prov-csv"
        },

        {
            "type": "merge",
            "description": "Adding a component to the output",
            "addOutputDirToInputPath": true,
            "input": "entities.provn",
            "input2": "activity.provn",
            "output": "entities-and-activity",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-entity-and-activity.prov-csv"
        },
        {
            "type": "merge",
            "description": "Adding a component to the output",
            "addOutputDirToInputPath": true,
            "input": "entities-and-activity.provn",
            "input2": "derivation.provn",
            "output": "entities-and-activity-and-derivation",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-entity-and-activity-and-derivation.prov-csv"
        },
        {
            "type": "merge",
            "description": "Adding a component to the output",
            "addOutputDirToInputPath": true,
            "input": "entities-and-activity-and-derivation.provn",
            "input2": "usage.provn",
            "output": "entities-and-activity-and-derivation-and-usage",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-entities-and-activity-and-derivation-and-usage.prov-csv"
        },
        {
            "type": "merge",
            "description": "Adding a component to the output",
            "addOutputDirToInputPath": true,
            "input": "entities-and-activity-and-derivation-and-usage.provn",
            "input2": "generation.provn",
            "output": "triangle-ugd",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "prov-triangle-ugd.prov-csv"
        }

    ]
}
