{
    "template_path": ["templates"],
    "bindings_path": ["bindings/org/openprovenance/bindings/algebra/triangle3-aga"],
    "output_dir": "generated-templates",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an entity pattern",
            "template": "org.openprovenance.templates.primitive.Entity0",
            "output": "org/openprovenance/templates/triangles/triangle3-aga/entity",
            "bindings": "entity.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle3-aga/prov/prov-entity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an agent pattern",
            "template": "org.openprovenance.templates.primitive.Agent0",
            "output": "org/openprovenance/templates/triangles/triangle3-aga/agent",
            "bindings": "agent.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle3-aga/prov/prov-agent.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an activity pattern",
            "template": "org.openprovenance.templates.primitive.Activity0",
            "output": "org/openprovenance/templates/triangles/triangle3-aga/activity",
            "bindings": "activity.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle3-aga/prov/prov-activity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a derivation pattern",
            "template": "org.openprovenance.templates.primitive.Attribution0",
            "output": "org/openprovenance/templates/triangles/triangle3-aga/attribution",
            "bindings": "attribution.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle3-aga/prov/prov-attribution.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an association pattern",
            "template": "org.openprovenance.templates.primitive.Association0",
            "output": "org/openprovenance/templates/triangles/triangle3-aga/association",
            "bindings": "association.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle3-aga/prov/prov-association.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating a generation pattern",
            "template": "org.openprovenance.templates.primitive.Generation0",
            "output": "org/openprovenance/templates/triangles/triangle3-aga/generation",
            "bindings": "generation.json",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle3-aga/prov/prov-generation.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": [
                "org/openprovenance/templates/triangles/triangle3-aga/entity",
                "org/openprovenance/templates/triangles/triangle3-aga/activity",
                "org/openprovenance/templates/triangles/triangle3-aga/agent",
                "org/openprovenance/templates/triangles/triangle3-aga/association",
                "org/openprovenance/templates/triangles/triangle3-aga/attribution",
                "org/openprovenance/templates/triangles/triangle3-aga/generation"
            ],
            "output": "org/openprovenance/templates/triangles/triangle3-aga/triangle3-aga",
            "formats": ["provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/triangles/triangle3-aga/prov/prov-triangle3-aga.prov-csv"
        }

    ]
}
