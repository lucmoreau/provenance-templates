{
    "template_path": ["src/main/resources/templates"],
    "bindings_path": ["src/main/resources/bindings/org/openprovenance/bindings/generic/fs"],
    "output_dir": "generated-templates",

    "variableMaps": ["./common-ns.json"],

    "tasks": [
        {
            "type": "instantiate",
            "template": "org.openprovenance.templates.generic.Transforming1",
            "output": "org/openprovenance/templates/fs/file-transforming",
            "bindings": "file-transforming.json",
            "formats": ["jsonld", "provn", "png"],
            "hasProvenance": "org/openprovenance/templates/fs/prov/prov-file-transforming.prov-csv"
        },
        {
            "type": "instantiate",
            "template": "org.openprovenance.templates.generic.Transforming1",
            "output": "org/openprovenance/templates/fs/file-validating",
            "bindings": "file-validating.json",
            "formats": ["jsonld", "provn", "png"],
            "hasProvenance": "org/openprovenance/templates/fs/prov/prov-file-validating.prov-csv"
        },
        {
            "type": "instantiate",
            "template": "org.openprovenance.templates.generic.Transforming1",
            "output": "org/openprovenance/templates/fs/file-training",
            "bindings": "file-training.json",
            "formats": ["jsonld", "provn", "png"],
            "hasProvenance": "org/openprovenance/templates/fs/prov/prov-file-training.prov-csv"
        },
        {
            "type": "instantiate",
            "template": "org.openprovenance.templates.generic.Transforming1",
            "output": "org/openprovenance/templates/fs/file-filtering",
            "bindings": "file-filtering.json",
            "formats": ["jsonld", "provn", "png"],
            "hasProvenance": "org/openprovenance/templates/fs/prov/prov-file-filtering.prov-csv"
        },
        {
            "type": "instantiate",
            "template": "org/openprovenance/templates/generic/product2-2",
            "template_path": ["target/generated-templates"],
            "output": "org/openprovenance/templates/fs/file-approving",
            "bindings": "file-approving.json",
            "formats": ["jsonld", "provn", "png"],
            "hasProvenance": "org/openprovenance/templates/fs/prov/prov-file-approving.prov-csv"
        },
        {
            "type": "instantiate",
            "template": "org/openprovenance/templates/generic/forking2",
            "template_path": ["target/generated-templates"],
            "output": "org/openprovenance/templates/fs/file-splitting",
            "bindings": "file-splitting.json",
            "formats": ["jsonld", "provn", "png"],
            "hasProvenance": "org/openprovenance/templates/fs/prov/prov-file-splitting.prov-csv"
        }
    ]


}


