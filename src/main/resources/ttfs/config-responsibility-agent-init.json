{
    "template_path": ["templates"],
    "bindings_path": ["bindings/org/openprovenance/bindings/responsibility/agent-init"],
    "output_dir": "generated-templates",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an agent pattern",
            "template": "org.openprovenance.templates.primitive.Agent0",
            "output": "org/openprovenance/templates/responsibility/agent-init/agent",
            "bindings": "agent-ag0-ag.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/responsibility/agent-init/prov/prov-agent.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an agent pattern",
            "template": "org.openprovenance.templates.primitive.Agent0",
            "output": "org/openprovenance/templates/responsibility/agent-init/agent-location",
            "bindings": "agent-ag0-ag-location.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/responsibility/agent-init/prov/prov-agent-location.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a specialization pattern",
            "template": "org.openprovenance.templates.primitive.Qualified-Specialization0",
            "bindings": "specialization.json",
            "output": "org/openprovenance/templates/responsibility/agent-init/specialization",
            "formats": ["jsonld", "provn","png", "svg"],
            "hasProvenance": "org/openprovenance/templates/responsibility/agent-init/prov/prov-specialization.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an activity pattern",
            "template": "org.openprovenance.templates.primitive.Activity0",
            "output": "org/openprovenance/templates/responsibility/agent-init/activity",
            "bindings": "activity.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/responsibility/agent-init/prov/prov-activity.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating a generation pattern for two entities",
            "template": "org.openprovenance.templates.primitive.Generation0",
            "output": "org/openprovenance/templates/responsibility/agent-init/generation",
            "bindings": "generation.json",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/responsibility/agent-init/prov/prov-generation.prov-csv"
        },

        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": [
                "org/openprovenance/templates/responsibility/agent-init/agent",
                "org/openprovenance/templates/responsibility/agent-init/specialization",
                "org/openprovenance/templates/responsibility/agent-init/activity",
                "org/openprovenance/templates/responsibility/agent-init/generation"
            ],
            "output": "org/openprovenance/templates/responsibility/agent-init/agent-init",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/responsibility/agent-init/prov/prov-agent-init.prov-csv"
        },
        {
            "type": "merge",
            "description": "Merging the above templates into a single template",
            "addOutputDirToInputPath": true,
            "inputs": [
                "org/openprovenance/templates/responsibility/agent-init/agent-location",
                "org/openprovenance/templates/responsibility/agent-init/specialization",
                "org/openprovenance/templates/responsibility/agent-init/activity",
                "org/openprovenance/templates/responsibility/agent-init/generation"
            ],
            "output": "org/openprovenance/templates/responsibility/agent-init/agent-location-init",
            "formats": ["jsonld", "provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/responsibility/agent-init/prov/prov-agent-location-init.prov-csv"
        }

    ]
}
