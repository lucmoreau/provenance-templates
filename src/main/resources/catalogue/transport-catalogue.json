{
    "group": "org.openprovenance.templates.physical",
    "name": "transport_template_library",
    "destination": "target",
    "description": "PROV templates for prov template management",
    "version": "0.1.0",
    "root_package": "org.openprovenance.templates.catalogue.transport",
    "script": "physical_run",
    "script_dir": "target/bin",
    "python_dir": "target/generated-python",
    "integrator": true,
    "jsweet": true,
    "jsonschema": "schema-transport.json",
    "documentation": "doc-transport.html",
    "sqlFile": "prov-template-library-transport.sql",
    "search": ["activity", "item"],

    "variableCheck": "src/main/resources/variable-check/transport/variables.json",

    "templates" : [


        {
            "@type": "simple",
            "name": "transporting",
            "fullyQualifiedName": "org.openprovenance.book.Transporting",
            "package": "org.openprovenance.book.physical",
            "template": "org.openprovenance.templates.physical.Transporting",
            "cbindings": "org/openprovenance/cbindings/physical/transporting.json"
        },
        {
            "@type": "simple",
            "name": "handingover",
            "fullyQualifiedName": "org.openprovenance.book.HandingOver",
            "package": "org.openprovenance.book.responsibility",
            "template": "org.openprovenance.templates.responsibility.HandingOver",
            "cbindings": "org/openprovenance/cbindings/responsibility/handingover.json"
        },
        {
            "@type": "simple",
            "name": "weighing",
            "fullyQualifiedName": "org.openprovenance.book.Weighing",
            "package": "org.openprovenance.book.physical",
            "template": "org.openprovenance.templates.physical.Weighing",
            "cbindings": "org/openprovenance/cbindings/physical/weighing.json"
        },
        {
            "@type": "simple",
            "name": "agent_init",
            "fullyQualifiedName": "org.openprovenance.book.AgentInit",
            "package": "org.openprovenance.book.physical",
            "template": "org/openprovenance/templates/responsibility/agent-init/agent-location-init",
            "cbindings": "org/openprovenance/cbindings/responsibility/agent-location-init.json"
        },
        {
            "@type": "simple",
            "name": "item_init",
            "fullyQualifiedName": "org.openprovenance.book.EntityInit",
            "package": "org.openprovenance.book.physical",
            "template": "org/openprovenance/templates/general/entity-init/entity-location-init",
            "cbindings": "org/openprovenance/cbindings/physical/item-location-init.json"
        },
        {
            "@type": "simple",
            "name": "packing",
            "fullyQualifiedName": "org.openprovenance.book.Packing",
            "package": "org.openprovenance.book.physical",
            "template": "org.openprovenance.templates.physical.Packing",
            "cbindings": "org/openprovenance/cbindings/physical/packing.json"
        },
        {
            "@type": "composite",
            "name": "packing_composite",
            "fullyQualifiedName": "org.openprovenance.book.PackingComposite",
            "consistsOf": "org.openprovenance.book.Packing",
            "package": "org.openprovenance.book.physical",
            "sharing": ["container1", "adding"]
        },

        {
            "@type": "simple",
            "name": "unpacking",
            "fullyQualifiedName": "org.openprovenance.templates.physical.Unpacking",
            "package": "org.openprovenance.book.physical",
            "template": "org.openprovenance.templates.physical.Unpacking",
            "cbindings": "org/openprovenance/cbindings/physical/unpacking.json"
        },
        {
            "@type": "composite",
            "name": "unpacking_composite",
            "fullyQualifiedName": "org.openprovenance.book.UnpackingComposite",
            "package": "org.openprovenance.book.physical",
            "consistsOf": "org.openprovenance.templates.physical.Unpacking",
            "sharing": ["container1", "removing"]
        }



    ],
    "sql.tables":  {
        "activity": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        },
        "item": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        },
        "people": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        },
        "document": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        }
    },
    "past-generators": {
        "BoxWorkflow": {
            "class": "org.openprovenance.bookptm.workflows.GenerateBoxWorkflow",
            "parameters": {},
            "classpath": ["target/classes"]
        }
    }
}
