{
    "group": "org.openprovenance.templates.physical",
    "name": "transport_template_library",
    "destination": "target",
    "description": "PROV templates for prov template management",
    "version": "0.1.0",
    "root_package": "org.openprovenance.templates.catalogue.transport",
    "script": "physical_run",
    "script_dir": "target/bin",
    "python_dir": "target/generated-python",
    "javascript_dir": "target/generated-js",
    "rust_dir": "target/generated-rust/src",
    "integrator": true,
    "jsweet": true,
    "jsonschema": "schema-transport.json",
    "documentation": "doc-transport.html",
    "sqlFile": "prov-template-library-transport.sql",
    "search": ["activity", "item"],

    "variableCheck": "src/main/resources/variable-check/transport/variables.json",

    "templates" : [


        {
            "@type": "simple",
            "name": "transporting",
            "fullyQualifiedName": "org.openprovenance.templates.transport.Transporting",
            "package": "org.openprovenance.book.physical",
            "template": "org.openprovenance.templates.transport.Transporting",
            "cbindings": "org/openprovenance/cbindings/physical/transporting.json"
        },
        {
            "@type": "simple",
            "name": "handingover",
            "fullyQualifiedName": "org.openprovenance.templates.transport.HandingOver",
            "package": "org.openprovenance.book.responsibility",
            "template": "org.openprovenance.templates.responsibility.HandingOver",
            "cbindings": "org/openprovenance/cbindings/responsibility/handingover.json"
        },
        {
            "@type": "simple",
            "name": "weighing",
            "fullyQualifiedName": "org.openprovenance.templates.transport.Weighing",
            "package": "org.openprovenance.book.physical",
            "template": "org.openprovenance.templates.transport.Weighing",
            "cbindings": "org/openprovenance/cbindings/physical/weighing.json"
        },
        {
            "@type": "simple",
            "name": "agent_init",
            "fullyQualifiedName": "org.openprovenance.templates.responsibility.AgentInit",
            "package": "org.openprovenance.book.physical",
            "template": "org.openprovenance.templates.responsibility.AgentLocationInit",
            "cbindings": "org/openprovenance/cbindings/responsibility/agent-location-init.json"
        },
        {
            "@type": "simple",
            "name": "item_init",
            "fullyQualifiedName": "org.openprovenance.templates.transport.EntityInit",
            "package": "org.openprovenance.book.physical",
            "template": "org.openprovenance.templates.responsibility.EntityLocationInit",
            "cbindings": "org/openprovenance/cbindings/physical/item-location-init.json"
        },
        {
            "@type": "simple",
            "name": "packing",
            "fullyQualifiedName": "org.openprovenance.templates.transport.Packing",
            "package": "org.openprovenance.book.physical",
            "template": "org.openprovenance.templates.transport.Packing",
            "cbindings": "org/openprovenance/cbindings/physical/packing.json"
        },
        {
            "@type": "composite",
            "name": "packing_composite",
            "fullyQualifiedName": "org.openprovenance.templates.transport.PackingComposite",
            "consistsOf": "org.openprovenance.templates.transport.Packing",
            "package": "org.openprovenance.book.physical",
            "sharing": ["container1", "adding"]
        },

        {
            "@type": "simple",
            "name": "unpacking",
            "fullyQualifiedName": "org.openprovenance.templates.transport.Unpacking",
            "package": "org.openprovenance.book.physical",
            "template": "org.openprovenance.templates.transport.Unpacking",
            "cbindings": "org/openprovenance/cbindings/physical/unpacking.json"
        },
        {
            "@type": "composite",
            "name": "unpacking_composite",
            "fullyQualifiedName": "org.openprovenance.templates.transport.UnpackingComposite",
            "package": "org.openprovenance.book.physical",
            "consistsOf": "org.openprovenance.templates.transport.Unpacking",
            "sharing": ["container1", "removing"]
        }



    ],
    "sql.tables":  {
        "activity": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        },
        "item": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        },
        "people": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        },
        "document": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        }
    },
    "past-generators": {
        "BoxWorkflow": {
            "class": "org.openprovenance.bookptm.workflows.GenerateBoxWorkflow",
            "parameters": {},
            "classpath": ["target/classes"]
        }
    }
}
