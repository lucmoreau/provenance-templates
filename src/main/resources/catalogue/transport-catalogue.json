{
    "group": "org.openprovenance.templates.physical",
    "name": "transport_template_library",
    "destination": "target",
    "description": "PROV templates for prov template management",
    "version": "2.2.2-SNAPSHOT",
    "root_package": "org.openprovenance.templates.catalogue.transport",
    "script": "physical_run",
    "script_dir": "target/bin",
    "python_dir": "target/generated-python",
    "integrator": true,
    "jsweet": true,
    "jsonschema": "schema-transport.json",
    "documentation": "doc-transport.html",
    "sqlFile": "prov-template-library-transport.sql",
    "search": ["activity", "item"],

    "templates" : [


        {
            "@type": "simple",
            "name": "transporting",
            "template": "target/generated-templates/physical/transporting/transporting.jsonld",
            "package": "org.openprovenance.templates.physical",
            "bindings": "src/main/resources/bindings0/physical/transporting.json"
        },
        {
            "@type": "simple",
            "name": "handingover",
            "template": "target/generated-templates/responsibility/handingover/handingover.jsonld",
            "package": "org.openprovenance.templates.responsibility",
            "bindings": "src/main/resources/bindings0/responsibility/handingover.json"
        },

        {
            "@type": "simple",
            "name": "weighing",
            "template": "target/generated-templates/physical/weighing/weighing.jsonld",
            "package": "org.openprovenance.templates.physical",
            "bindings": "src/main/resources/bindings0/physical/weighing.json"
        },
        {
            "@type": "simple",
            "name": "agent_init",
            "template": "target/generated-templates/responsibility/agent-init/agent-location-init.jsonld",
            "package": "org.openprovenance.templates.physical",
            "bindings": "src/main/resources/bindings0/responsibility/agent-location-init.json"
        },
        {
            "@type": "simple",
            "name": "item_init",
            "template": "target/generated-templates/general/entity-init/entity-location-init.jsonld",
            "package": "org.openprovenance.templates.physical",
            "bindings": "src/main/resources/bindings0/physical/item-location-init.json"
        },
        {
            "@type": "simple",
            "name": "packing",
            "template": "target/generated-templates/physical/packing/packing.jsonld",
            "package": "org.openprovenance.templates.physical",
            "bindings": "src/main/resources/bindings0/physical/packing.json"
        },
        {
            "@type": "composite",
            "name": "packing_composite",
            "consistsOf": "packing",
            "package": "org.openprovenance.templates.physical",
            "sharing": ["container1", "adding"]
        },

        {
            "@type": "simple",
            "name": "unpacking",
            "template": "target/generated-templates/physical/unpacking/unpacking.jsonld",
            "package": "org.openprovenance.templates.physical",
            "bindings": "src/main/resources/bindings0/physical/unpacking.json"
        },
        {
            "@type": "composite",
            "name": "unpacking_composite",
            "consistsOf": "unpacking",
            "package": "org.openprovenance.templates.physical",
            "sharing": ["container1", "removing"]
        }



    ],
    "sql.tables":  {
        "activity": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        },
        "item": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        },
        "people": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        },
        "document": {
            "id": "SERIAL",
            "created_at": "timestamp with time zone NOT NULL DEFAULT NOW()"
        }
    }
}
