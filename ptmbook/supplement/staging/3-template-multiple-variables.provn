document
bundle vargen:b
prefix vargen <http://openprovenance.org/vargen#>
prefix var <http://openprovenance.org/var#>

activity(var:act,-,-)
entity(var:input,[var:iprops = 'var:ivalues'])
entity(var:output,[var:oprops = 'var:ovalues'])
agent(var:ag,[var:aprops = 'var:avalues'])
wasAssociatedWith(var:act,var:ag,-)
wasGeneratedBy(var:output,var:act,-)
used(var:act,var:input,-)
wasDerivedFrom(var:output, var:input,[var:dprops = 'var:dvalues'])
endBundle
endDocument
