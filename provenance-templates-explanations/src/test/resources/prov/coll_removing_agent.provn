// RemovingFromCollection with an associated agent, as in refinements such as Unpacking.
// Expected: The item (ex:item0) was removed from the collection (ex:coll0) by agent (ex:clerk) on 11 November 2026 at 14:30.
// Expected: Before the removal, the item (ex:item0) was a member of the collection (ex:coll0).
// Expected: The removal left the collection (ex:coll1) without the item (ex:item1).
document
prefix ex <http://example.org/>
prefix provext <https://openprovenance.org/ns/provext#>
prefix openprov <https://openprovenance.org/ns/openprov#>
entity(ex:coll0)
entity(ex:coll1,[prov:type = 'prov:Collection'])
entity(ex:item0)
entity(ex:item1)
activity(ex:removing1,2026-11-11T14:25:00,2026-11-11T14:30:00,[prov:type = 'openprov:RemovingElementFromCollection'])
used(ex:usd1;ex:removing1,ex:item0,-,[prov:role = 'openprov:asMember'])
used(ex:usd2;ex:removing1,ex:coll0,-,[prov:role = 'openprov:asCollection'])
wasGeneratedBy(ex:gen;ex:coll1,ex:removing1,-,[prov:role = 'openprov:asCollection'])
wasGeneratedBy(ex:gen2;ex:item1,ex:removing1,-,[prov:role = 'openprov:asMember'])
wasDerivedFrom(ex:der1;ex:coll1,ex:item0,ex:removing1,ex:gen,ex:usd1,[prov:type = 'openprov:RemovingElement'])
wasDerivedFrom(ex:der2;ex:coll1,ex:coll0,ex:removing1,ex:gen,ex:usd2,[prov:type = 'openprov:RemovingElementFromCollection'])
wasDerivedFrom(ex:der3;ex:item1,ex:item0,ex:removing1,ex:gen2,ex:usd1,[prov:type = 'openprov:RemovingElementFromCollection'])
provext:hadMember(ex:mem0;ex:coll0,ex:item0)
agent(ex:clerk)
wasAssociatedWith(ex:asc;ex:removing1,ex:clerk,-)
endDocument
