{
    "template_path": [
        "target/generated-templates"],
    "bindings_path": ["src/main/resources/bindings/org/openprovenance/bindings/ptm/creating-template"],
    "output_dir": "generated-templates",
    "variableMaps": ["./common-ns.json"],


    "tasks": [
        {
            "type": "instantiate",
            "description": "Instantiating an triangle1-ugd pattern",
            "template": "org.openprovenance.templates.triangles.Triangle1-UGD",
            "output": "org/openprovenance/templates/ptm/creating-template/creating-template-triangle1-ugd",
            "bindings": "creating-template-triangle1-ugd.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/ptm/creating-template/prov/creating-template-triangle1-ugd.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (a) pattern",
            "template": "org.openprovenance.templates.triangles.Triangle3-AGA",
            "output": "org/openprovenance/templates/ptm/creating-template/creating-template-triangle3a-aga",
            "bindings": "creating-template-triangle3a-aga.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/ptm/creating-template/prov/creating-template-triangle3a-aga.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (b) pattern",
            "template": "org.openprovenance.templates.triangles.Triangle3-AGA",
            "output": "org/openprovenance/templates/ptm/creating-template/creating-template-triangle3b-aga",
            "bindings": "creating-template-triangle3b-aga.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/ptm/creating-template/prov/creating-template-triangle3b-aga.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an triangle3-aga (c) pattern",
            "template": "org.openprovenance.templates.triangles.Triangle3-AGA",
            "output": "org/openprovenance/templates/ptm/creating-template/creating-template-triangle3c-aga",
            "bindings": "creating-template-triangle3c-aga.json",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/ptm/creating-template/prov/creating-template-triangle3c-aga.prov-csv"
        },
        {
            "type": "merge",
            "description": "Merging all creating-template triangle outputs",
            "addOutputDirToInputPath": true,
            "inputs": [
                "org/openprovenance/templates/ptm/creating-template/creating-template-triangle1-ugd",
                "org/openprovenance/templates/ptm/creating-template/creating-template-triangle3a-aga",
                "org/openprovenance/templates/ptm/creating-template/creating-template-triangle3b-aga",
                "org/openprovenance/templates/ptm/creating-template/creating-template-triangle3c-aga"
            ],
            "output": "org/openprovenance/templates/ptm/creating-template/creating-template",
            "formats": ["jsonld","provn", "png", "svg"],
            "hasProvenance": "org/openprovenance/templates/ptm/creating-template/prov/ptm-creating-template.prov-csv"
        }




    ]
}
