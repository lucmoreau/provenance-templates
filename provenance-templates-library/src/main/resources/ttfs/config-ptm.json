            "formats": ["jsonld", "provn", "png"],
            "hasProvenance": "org/openprovenance/templates/ptm/prov/prov-ptm-merging.prov-csv",
            "variableCheck": "src/main/resources/variable-check/ptm/variables.json"


        },
        {
            "type": "instantiate",
            "template": "org/openprovenance/templates/generic/parallel2",
            "output": "org/openprovenance/templates/ptm/ptm-mexpanding",
            "bindings": "ptm-mexpanding.json",
            "formats": ["provn", "png"],
            "hasProvenance": "org/openprovenance/templates/ptm/prov/prov-ptm-mexpanding.prov-csv",
