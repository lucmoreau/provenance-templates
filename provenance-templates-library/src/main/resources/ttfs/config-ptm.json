            "variableCheck": "src/main/resources/variable-check/ptm/variables.json"
        },
        {
            "type": "instantiate",
            "template": "org/openprovenance/templates/generic/parallel2",
            "output": "org/openprovenance/templates/ptm/ptm-merging",
