        },


        {
            "type": "instantiate",
            "description": "Instantiating a membership pattern",
            "template": "org.openprovenance.templates.primitive.Qualified-Membership0",
            "output": "org/openprovenance/templates/collections/removing/membership",
            "bindings": "membership.json",
            "formats": ["jsonld", "provn","png", "svg"],
            "hasProvenance": "org/openprovenance/templates/collections/removing/prov/prov-membership.prov-csv"
        },

        {
            "type": "instantiate",
            "description": "Instantiating an agent pattern",
            "template": "org.openprovenance.templates.primitive.Agent0",
            "output": "org/openprovenance/templates/collections/removing/agent",
            "bindings": "agent.json",
            "formats": ["jsonld"],
            "hasProvenance": "org/openprovenance/templates/collections/removing/prov/prov-agent.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an attribution pattern",
            "template": "org.openprovenance.templates.primitive.Attribution0",
            "output": "org/openprovenance/templates/collections/removing/attribution1",
            "bindings": "attribution1.json",
            "formats": ["jsonld"],
            "hasProvenance": "org/openprovenance/templates/collections/removing/prov/prov-attribution1.prov-csv"
        },
        {
            "type": "instantiate",
            "description": "Instantiating an attribution pattern",
            "template": "org.openprovenance.templates.primitive.Attribution0",
            "output": "org/openprovenance/templates/collections/removing/attribution2",
            "bindings": "attribution2.json",
            "formats": ["jsonld"],
            "hasProvenance": "org/openprovenance/templates/collections/removing/prov/prov-attribution2.prov-csv"
