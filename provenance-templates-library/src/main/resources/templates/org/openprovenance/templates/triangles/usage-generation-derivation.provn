document
bundle vargen:bundle
prefix vargen <http://openprovenance.org/vargen#>
prefix tmpl <http://openprovenance.org/ns/tmpl#>
prefix var <http://openprovenance.org/var#>

activity(var:a,-,-,[prov:type = 'var:activityType', var:aprops = 'var:avalues'])
entity(var:e0,[prov:type = 'var:entityType0', var:eprops0 = 'var:evalues0'])
entity(var:e1,[prov:type = 'var:entityType1', var:eprops1 = 'var:evalues1'])
used(vargen:u;var:a,var:e0,-,[tmpl:time = 'var:time0'])
wasGeneratedBy(vargen:g;var:e1,var:a,-,[tmpl:time = 'var:time1'])
wasDerivedFrom(var:e1, var:e0, var:a, vargen:g, vargen:u)
endBundle
endDocument
