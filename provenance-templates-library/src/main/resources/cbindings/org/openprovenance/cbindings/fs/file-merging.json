{
    "var": {
        "outfile": [
            {
                "@id": "file:*",
                "@type": "xsd:int",
                "@examplar": 122,
                "@documentation": "The file resulting from merging",
                "@input": "false",
                "@output": "true",
                "@sql.table": "file"
            }
        ],
        "filename": [
            [
                {
                    "@value": "*",
                    "@type": "xsd:string",
                    "@examplar": "file/123b.csv",
                    "@documentation": "The file name resulting from the merging",
                    "@input": "compulsory",
                    "@output": "false",
                    "@sql.type": "nonNullableTEXT"
                }
            ]
        ],
        "infile1": [
            {
                "@id": "file:*",
                "@type": "xsd:int",
                "@examplar": 120,
                "@documentation": "The first file before merging",
                "@input": "compulsory",
                "@sql.table": "file"
            }
        ],
        "infile2": [
            {
                "@id": "file:*",
                "@type": "xsd:int",
                "@examplar": 121,
                "@documentation": "The second file before merging",
                "@input": "compulsory",
                "@sql.table": "file"
            }
        ],
        "method": [
            {
                "@id": "method:*",
                "@type": "xsd:int",
                "@examplar": 222,
                "@documentation": "The method to merge the files",
                "@input": "optional",
                "@output": "false",
                "@sql.table": "method"
            }
        ],
        "engineer": [
            {
                "@id": "ag:*",
                "@type": "xsd:int",
                "@documentation": "The engineer developing the ML pipeline",
                "@input": "optional",
                "@sql.table": "agent"
            }
        ],
        "merging": [
            {
                "@id": "act:*",
                "@type": "xsd:int",
                "@documentation": "The activity of merging the files",
                "@output": "true",
                "@sql.table": "activity"
            }
        ],
        "path": [
            [
                {
                    "@value": "*",
                    "@type": "xsd:string",
                    "@documentation": "The actual path of the file",
                    "@input": "optional",
                    "@sql.type": "nullableTEXT"
                }
            ]
        ],
        "time": [
            [
                {
                    "@value": "*",
                    "@type": "xsd:dateTime",
                    "@documentation": "Time when the merged file is created",
                    "@input": "optional",
                    "@sql.type": "timestamptz"
                }
            ]
        ],
        "start": [
            [
                {
                    "@value": "*",
                    "@type": "xsd:dateTime",
                    "@documentation": "Time when the merging starts",
                    "@input": "optional",
                    "@sql.type": "timestamptz"
                }
            ]
        ],
        "end": [
            [
                {
                    "@value": "*",
                    "@type": "xsd:dateTime",
                    "@documentation": "Time when the merging ends",
                    "@input": "optional",
                    "@sql.type": "timestamptz"
                }
            ]
        ]
    },
    "context": {
        "ag": "${PROV_API}/live/agent/",
        "act": "${PROV_API}/live/activity/",
        "file": "${PROV_API}/live/file/",
        "method": "${PROV_API}/live/method/"
    },
    "template": "TODO template",
    "@documentation": "TODO doc."
}
